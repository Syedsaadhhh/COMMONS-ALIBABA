# COMMONS Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real credentials.

# Public deployment URL used for canonical social preview links
NEXT_PUBLIC_SITE_URL=

# Qwen / Alibaba Cloud Model Studio (server only)
DASHSCOPE_API_KEY=
# Optional: override the model or endpoint for the AI planning route
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Supabase public browser credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
